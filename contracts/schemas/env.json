{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hackcure/env.json",
  "title": "hackcure/room/{room}/env",
  "type": "object",
  "required": ["ts", "source", "tempC", "humidity"],
  "properties": {
    "ts": { "type": "string" },
    "source": { "type": "string" },
    "tempC": { "type": "number", "minimum": -20, "maximum": 60 },
    "humidity": { "type": "number", "minimum": 0, "maximum": 100 },
    "motion": { "type": "boolean" },
    "doorOpen": { "type": "boolean" },
    "lux": { "type": ["number", "null"] }
  },
  "additionalProperties": true
}
