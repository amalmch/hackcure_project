{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hackcure/cmd_ack.json",
  "title": "hackcure/room/{room}/cmd/ack  (edge -> serveur)",
  "type": "object",
  "required": ["ts", "source", "equipment", "action", "ok", "state"],
  "properties": {
    "ts": { "type": "string" },
    "source": { "type": "string" },
    "equipment": { "enum": ["window", "heater", "ac", "light", "buzzer"] },
    "action": { "type": "string" },
    "ok": { "type": "boolean" },
    "state": { "type": "string" },
    "commandId": { "type": ["string", "null"] },
    "error": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
