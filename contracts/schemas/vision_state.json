{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hackcure/vision_state.json",
  "title": "hackcure/room/{room}/vision/state (2 Hz)",
  "type": "object",
  "required": ["ts", "source", "persons", "posture", "activity", "zone", "confidence"],
  "properties": {
    "ts": { "type": "string" },
    "source": { "type": "string" },
    "persons": { "type": "integer", "minimum": 0 },
    "patientTrackId": { "type": ["integer", "null"] },
    "posture": { "enum": ["lying_bed", "sitting_bed", "sitting_chair", "standing", "walking", "on_floor", "absent"] },
    "activity": { "enum": ["sleeping", "awake_bed", "out_of_bed", "toilet", "out_of_room", "fall"] },
    "zone": { "enum": ["bed", "floor", "bathroom_door", "exit", "none"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "cvClass": { "type": ["string", "null"] },
    "floorPos": {
      "type": ["object", "null"],
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    }
  },
  "additionalProperties": true
}
