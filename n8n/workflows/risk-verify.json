      "id": "2434f9e5-1241-5e7c-9d05-0f26c659a072",
      "name": "Plateforme : état de la chambre",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CRED_PLATFORM__",
          "name": "Hospital Copilot — Plateforme (jeton de service)"
        }
      },
      "retryOnFail": true,
