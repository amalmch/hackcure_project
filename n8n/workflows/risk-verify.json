    {
      "parameters": {
        "jsCode": "const ctx = $('Contexte').first().json;\nconst state = $input.first().json || {};\n// Seuls les risques encore ouverts et délégués à ce workflow sont re-vérifiés\nconst risks = (state.open_risks || []).filter((r) => ctx.risk_ids.includes(Number(r.id)));\nif (!risks.length) return [];\n\nconst context = {\n  chambre: ctx.room,\n  patient: { nom: ctx.patient.full_name, age: ctx.patient.age, allergies: ctx.patient.allergies, antecedents: ctx.patient.history },\n  duree_de_la_visite_s: ctx.duration_s,\n  etat_actuel: { posture: state.posture, activite: state.activity, zone: state.zone, expression: state.expression, personnes: state.persons, temperature_cutanee_c: state.skinTempC },\n  constantes_actuelles: state.vitals || {},\n  environnement: state.env || {},\n  risques_a_verifier: risks.map((r) => ({ risk_id: r.id, type: r.type, libelle: r.type_label, titre: r.title, severite: r.severity, explication: r.explanation, controle_deterministe: r.auto_check })),\n};\nconst system = [\n  \"Tu es l'assistant de vérification d'une clinique (Hospital Copilot). Le personnel vient de quitter la chambre : tu dois dire, pour chaque risque, s'il est résolu d'après l'ÉTAT ACTUEL mesuré.\",\n  \"Règles : n'invente aucune valeur ; cite les valeurs actuelles (posture, activité, constantes) dans ta justification ; en cas de doute, le risque n'est PAS résolu.\",\n  \"Réponds en français, UNIQUEMENT par un objet JSON valide, sans texte autour et sans balise Markdown.\",\n].join('\\n');\nconst user = `Contexte (JSON) :\\n${JSON.stringify(context, null, 1)}\\n\\nFormat exact : {\"verdicts\": [{\"risk_id\": 0, \"resolved\": true, \"justification\": \"1 à 2 phrases courtes (300 caractères au plus) citant les valeurs\"}]}`;\nreturn [{ json: { risks, state_summary: context.etat_actuel, vitals: context.constantes_actuelles, request: { model: ctx.model, max_tokens: 8000, system, messages: [{ role: 'user', content: user }] } } }];\n"
      },
      "id": "ac9b835b-916e-5640-80b7-f08b93037ccd",
      "name": "Construire le prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "7832f1d7-c8d7-54b1-a9fc-2e5663a2783d",
      "name": "Claude : risque résolu ?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CRED_ANTHROPIC__",
          "name": "Hospital Copilot — Anthropic (x-api-key)"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Extrait l'objet JSON de la réponse Anthropic (content[].text) ; lève une erreur si absent ou invalide.\nfunction parseClaude(res) {\n  if (!res || res.error) throw new Error(typeof (res || {}).error === 'string' ? res.error : ((res || {}).error || {}).message || 'appel Anthropic en échec');\n  const text = (res.content || []).filter((b) => b.type === 'text').map((b) => b.text).join('');\n  if (!text) throw new Error('réponse vide');\n  const m = text.match(/\\{[\\s\\S]*\\}/);\n  return JSON.parse(m ? m[0] : text);\n}\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst ctx = $('Contexte').first().json;\nconst prep = $('Construire le prompt').first().json;\nconst res = $input.first().json;\nlet verdicts = [], error = null;\ntry {\n  const out = parseClaude(res);\n  verdicts = Array.isArray(out.verdicts) ? out.verdicts : [];\n  if (!verdicts.length) throw new Error('aucun verdict');\n} catch (e) { error = e.message; }\n\nreturn prep.risks.map((r) => {\n  const v = verdicts.find((x) => Number(x.risk_id) === Number(r.id));\n  const check = r.auto_check || { ok: false, detail: 'contrôle indisponible' };\n  const fallback = !v || typeof v.resolved !== 'boolean';\n  // Garde-fou : jamais « résolu » si le contrôle déterministe de la plateforme échoue ; sans réponse du LLM, seul ce contrôle décide.\n  const resolved = fallback ? check.ok === true : (v.resolved === true && check.ok === true);\n  let justification = fallback ? `Réponse de secours (LLM indisponible${error ? ' : ' + error : ''}) — contrôle déterministe : ${check.detail}.` : String(v.justification || '').trim();\n  if (!fallback && v.resolved === true && !check.ok) justification += ` (Contrôle déterministe en échec : ${check.detail} — risque maintenu.)`;\n  const head = resolved ? `✅ <b>Résolu et vérifié</b> — ${esc(r.title)}` : `⚠️ <b>Risque persistant après visite</b> — ${esc(r.title)}`;\n  return { json: {\n    started_at: ctx.started_at, risk_id: r.id, room: ctx.room, platform_url: ctx.platform_url, chat_id: ctx.chat_id,\n    resolved, fallback, justification, title: r.title, model_used: (res && res.model) || ctx.model, anthropic_id: (res && res.id) || null,\n    body: { verified: true, justification, reason: justification, source: 'n8n:risk-verify' },\n    telegram_text: `${head}\\nChambre <b>${esc(ctx.room)}</b> — ${esc(ctx.patient.full_name || 'Patient')}\\n${esc(justification)}\\n${resolved ? '' : 'Médecin de garde sollicité.\\n'}${ctx.platform_url}/`,\n  } };\n});\n"
      },
